diff --git a/experiments/hot_cache/test.py b/experiments/hot_cache/test.py
new file mode 100644
index 0000000..de50b3a
--- /dev/null
+++ b/experiments/hot_cache/test.py
@@ -0,0 +1,63 @@
+"""Isolated fixture correctness tests; no production performance claims."""
+import json
+import os
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+probe = pathlib.Path(sys.argv[1]).resolve()
+root = pathlib.Path(tempfile.mkdtemp(prefix="hot-cache-fixture-", dir=sys.argv[2]))
+db, snapshot = root / "db", root / "snapshot"
+
+
+def run(mode, cap=8 * 1024 * 1024, ok=True, fail_publish=False):
+    p = subprocess.run([str(probe), str(db), str(snapshot), str(mode), str(cap)],
+                       text=True, capture_output=True, timeout=30,
+                       env=dict(os.environ, **({"RSHC_TEST_FAIL_BEFORE_RENAME": "1"} if fail_publish else {})))
+    if not ok:
+        assert p.returncode != 0, p.stdout
+        return
+    assert p.returncode == 0, (p.stdout, p.stderr)
+    result = json.loads(next(line for line in p.stdout.splitlines() if line.startswith("{")))
+    assert result["reads"] == 2048
+    return result
+
+
+seed = run(0)
+assert seed["captured_data"] > 0 and seed["captured_metadata"] > 0
+assert seed["written_bytes"] <= 8 * 1024 * 1024
+for mode in (1, 2, 1):
+    r = run(mode)
+    assert r["data_hits"] > 0 and r["metadata_hits"] > 0, r
+    assert not r["snapshot_rejected"]
+print("restart-recapture-restart", json.dumps(r))
+original = snapshot.read_bytes()
+# Atomic publication failure preserves the previous complete generation.
+(snapshot.parent / "snapshot.tmp").write_bytes(b"occupied")
+run(2, ok=False, fail_publish=True)
+assert snapshot.read_bytes() == original
+run(2)  # stale/foreign temporary is ignored and publication resumes.
+assert (snapshot.parent / "snapshot.tmp").read_bytes() == b"occupied"
+(snapshot.parent / "snapshot.tmp").unlink()
+run(0, ok=False)  # Never seed over an existing fixture.
+# Reject bad format before passing bytes to native block decoders.
+for label, damaged in (
+    ("truncation", original[:-1]),
+    ("checksum", original[:-1] + bytes([original[-1] ^ 1])),
+    ("version", original[:8] + (2).to_bytes(4, "little") + original[12:]),
+    ("oversized-length", original[:20] + (0xffffffff).to_bytes(4, "little") + original[24:]),
+):
+    snapshot.write_bytes(damaged)
+    r = run(1)
+    assert r["snapshot_rejected"] and r["secondary_hits"] == 0, r
+    print(label, "fallback verified")
+snapshot.write_bytes(original)
+r = run(2, 16)
+assert r["written_bytes"] == 16 and r["captured_data"] == r["captured_metadata"] == 0
+r = run(1, 16)
+assert not r["snapshot_rejected"] and r["snapshot_entries"] == 0
+snapshot.unlink()
+r = run(1)
+assert not r["snapshot_rejected"] and r["secondary_hits"] == 0
+print("byte-cap and missing-snapshot fallback verified; retained fixture", root)
