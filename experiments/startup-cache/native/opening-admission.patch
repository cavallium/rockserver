+extern "C" int rocksdb_async_open_admission_enable(uint32_t maximum,
+                                                   uint32_t interval_ms) {
+  if (maximum == 0 || maximum > 1024 || interval_ms == 0 ||
+      interval_ms > 60000) {
+    return -1;
+  }
+  try {
+    if (ROCKSDB_NAMESPACE::ExperimentalAsyncFileOpenAdmission()) return -2;
+    std::shared_ptr<ROCKSDB_NAMESPACE::AsyncFileOpenAdmission> expected;
+    auto gate = std::make_shared<ROCKSDB_NAMESPACE::AsyncFileOpenAdmission>(
+        maximum, interval_ms);
+    return std::atomic_compare_exchange_strong(
+               &ROCKSDB_NAMESPACE::experimental_admission, &expected, gate)
+               ? 0
+               : -2;
+  } catch (...) {
+    // No C++ exception may escape the C/FFM boundary, including allocation or
+    // synchronization-resource failure during controller construction.
+    return -3;
+  }
+}
+extern "C" int rocksdb_async_open_admission_feedback(int pressure) {
+  try {
+    auto gate = ROCKSDB_NAMESPACE::ExperimentalAsyncFileOpenAdmission();
+    if (gate) gate->Feedback(pressure != 0);
+    return 0;
+  } catch (...) {
+    return -3;
+  }
+}
+extern "C" uint64_t rocksdb_async_open_admission_counter(uint32_t selector) {
