+bool AsyncFileOpenAdmission::Acquire(const std::atomic<bool>* stop,
+                                     const std::atomic<bool>* peer_error) {
+  const auto start = Clock::now();
+  std::unique_lock<std::mutex> lock(mutex_);
+  // The waiter destructs before lock, unlinking safely on any exception.
+  Waiter waiter(this);
+  waiter.previous = last_waiter_;
+  if (last_waiter_ != nullptr)
+    last_waiter_->next = &waiter;
+  else
+    first_waiter_ = &waiter;
+  last_waiter_ = &waiter;
+  ++waiters_;
+  TEST_SYNC_POINT("AsyncFileOpenAdmission::Enqueued");
+  for (;;) {
+    if ((stop != nullptr && stop->load(std::memory_order_acquire)) ||
+        (peer_error != nullptr &&
+         peer_error->load(std::memory_order_acquire))) {
+      RemoveWaiter(&waiter);
+      ++cancelled_;
+      wait_micros_ += std::chrono::duration_cast<std::chrono::microseconds>(
+                          Clock::now() - start)
+                          .count();
+      return false;
+    }
+    const auto now = Clock::now();
+    if (first_waiter_ == &waiter && active_ < limit_ &&
+        (!pressure_ || now >= next_progress_)) {
+      RemoveWaiter(&waiter);
+      ++active_;
+      ++admitted_;
+      if (pressure_) ++pressured_admissions_;
+      peak_active_ = std::max(peak_active_, active_);
+      wait_micros_ +=
+          std::chrono::duration_cast<std::chrono::microseconds>(now - start)
+              .count();
+      next_progress_ = now + interval_;
+      return true;
+    }
+    TEST_SYNC_POINT("AsyncFileOpenAdmission::Waiting");
+    // Notification wakes waiters. Bounded polling covers a notification race
+    // or a stop published by an alternate close path without notification.
+    cv_.wait_until(lock, std::min(now + std::chrono::milliseconds(10),
+                                  pressure_ && next_progress_ > now
+                                      ? next_progress_
+                                      : now + std::chrono::milliseconds(10)));
+  }
+}
+void AsyncFileOpenAdmission::RemoveWaiter(Waiter* waiter) {
+  if (waiter->previous != nullptr)
+    waiter->previous->next = waiter->next;
+  else
+    first_waiter_ = waiter->next;
+  if (waiter->next != nullptr)
+    waiter->next->previous = waiter->previous;
+  else
+    last_waiter_ = waiter->previous;
+  waiter->queued = false;
+  --waiters_;
+  cv_.notify_all();
+}
+void AsyncFileOpenAdmission::Release(bool table_load_attempted,
+                                     uint64_t table_load_micros,
+                                     uint64_t logical_bytes_read,
+                                     bool table_load_failed) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  assert(active_ > 0);
+  --active_;
+  ++released_;
+  if (table_load_attempted) {
+    ++table_loads_;
+    if (table_load_failed) ++failed_loads_;
+    table_load_micros_ += table_load_micros;
+    logical_bytes_read_ += logical_bytes_read;
+  }
+  cv_.notify_all();
+}
+void AsyncFileOpenAdmission::Feedback(bool pressure) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  // Feedback changes urgency, never the progress deadline. Even alternating
+  // pressure/healthy samples cannot postpone a queued open indefinitely.
+  pressure_ = pressure;
+  limit_ = pressure ? std::max(uint32_t{1}, limit_ / 2)
+                    : std::min(maximum_, limit_ + 1);
+  cv_.notify_all();
+}
+void AsyncFileOpenAdmission::NotifyWaiters() { cv_.notify_all(); }
+uint64_t AsyncFileOpenAdmission::Counter(uint32_t selector) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  switch (selector) {
+    case 0:
+      return active_;
+    case 1:
+      return waiters_;
+    case 2:
+      return admitted_;
+    case 3:
+      return cancelled_;
+    case 4:
