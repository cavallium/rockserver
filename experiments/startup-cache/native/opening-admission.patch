+// Admission is outside table loading locks: a foreground Get on the same SST
+// succeeds while every background opener is waiting for its first permit.
+TEST_F(DBTest, AsyncOpenAdmissionForegroundAndShutdown) {
+  Options options = CurrentOptions();
+  options.disable_auto_compactions = true;
+  options.max_open_files = -1;
+  options.max_file_opening_threads = 3;
+  DestroyAndReopen(options);
+  ASSERT_OK(Put("key", "value"));
+  ASSERT_OK(Flush());
+  Close();
+  ASSERT_EQ(rocksdb_async_open_admission_abi_version(), 1);
+  ASSERT_EQ(rocksdb_async_open_admission_enable(0, 1), -1);
+  const bool already_enabled = ExperimentalAsyncFileOpenAdmission() != nullptr;
+  ASSERT_EQ(rocksdb_async_open_admission_enable(3, 60000),
+            already_enabled ? -2 : 0);
+  const uint64_t admitted_before = rocksdb_async_open_admission_counter(2);
+  const uint64_t cancelled_before = rocksdb_async_open_admission_counter(3);
+  ASSERT_EQ(rocksdb_async_open_admission_enable(3, 60000), -2);
+  options.open_files_async = true;
+  options.skip_stats_update_on_db_open = true;
+  for (bool shutdown : {false, true}) {
+    rocksdb_async_open_admission_feedback(0);
+    rocksdb_async_open_admission_feedback(1);
+    std::promise<void> waiting;
+    std::atomic<bool> signalled{false};
+    auto* sync = SyncPoint::GetInstance();
+    sync->SetCallBack("AsyncFileOpenAdmission::Waiting", [&](void*) {
+      if (!signalled.exchange(true)) waiting.set_value();
+    });
+    sync->LoadDependency(
+        {{"DBImpl::BGWorkAsyncFileOpen:Done", "AsyncOpenAdmission::Done"}});
+    sync->EnableProcessing();
+    Reopen(options);
+    ASSERT_EQ(waiting.get_future().wait_for(std::chrono::seconds(5)),
+              std::future_status::ready);
+    ASSERT_EQ(Get("key"), "value");
+    ASSERT_EQ(rocksdb_async_open_admission_counter(0), 0);
+    if (!shutdown) {
+      rocksdb_async_open_admission_feedback(0);
+      TEST_SYNC_POINT("AsyncOpenAdmission::Done");
+      ASSERT_EQ(rocksdb_async_open_admission_counter(2), admitted_before + 1);
+      ASSERT_EQ(rocksdb_async_open_admission_counter(7), admitted_before + 1);
+    }
+    Close();
+    sync->DisableProcessing();
+    sync->ClearAllCallBacks();
+    sync->ClearTrace();
+    ASSERT_EQ(rocksdb_async_open_admission_counter(0), 0);
+    ASSERT_EQ(rocksdb_async_open_admission_counter(1), 0);
+  }
+  ASSERT_EQ(rocksdb_async_open_admission_counter(3), cancelled_before + 1);
+  rocksdb_async_open_admission_feedback(0);
+}
+
+TEST_F(DBTest, AsyncOpenAdmissionPeerErrorCancelsWaiter) {
+  Options options = CurrentOptions();
+  options.disable_auto_compactions = true;
+  DestroyAndReopen(options);
+  ASSERT_OK(Put("key", "value"));
+  ASSERT_OK(Flush());
+  auto* cfd =
+      static_cast_with_check<ColumnFamilyHandleImpl>(db_->DefaultColumnFamily())
+          ->cfd();
+  FileMetaData missing;
+  missing.fd = FileDescriptor(999999, 0, 123);
+  // Both workers target an absent file. Only its first owner may FindTable;
+  // its sibling must leave admission on peer failure, without another open.
+  std::vector<std::pair<FileMetaData*, int>> files = {{&missing, 0},
+                                                      {&missing, 0}};
+  AsyncFileOpenAdmission gate(1, 60000);
+  std::atomic<bool> stop{false};
+  std::promise<void> waiting;
+  std::atomic<bool> signalled{false};
+  std::atomic<uint32_t> finds{0};
+  auto* sync = SyncPoint::GetInstance();
+  sync->SetCallBack("AsyncFileOpenAdmission::Waiting", [&](void*) {
+    if (!signalled.exchange(true)) waiting.set_value();
+  });
+  sync->SetCallBack("VersionBuilder::Rep::LoadTableHandlers::BeforeFindTable",
+                    [&](void*) {
+                      if (finds.fetch_add(1) == 0) waiting.get_future().wait();
+                    });
+  sync->EnableProcessing();
+  Status result = LoadTableHandlersHelper(
+      files, cfd->table_cache(), FileOptions(options),
+      cfd->internal_comparator(), cfd->internal_stats(), 2, false,
+      cfd->GetLatestMutableCFOptions(), 0, ReadOptions(), &stop, &gate);
+  sync->DisableProcessing();
+  sync->ClearAllCallBacks();
+  ASSERT_FALSE(result.ok());
+  ASSERT_EQ(finds.load(), 1);
+  ASSERT_EQ(gate.Counter(0), 0);
+  ASSERT_EQ(gate.Counter(1), 0);
+  ASSERT_EQ(gate.Counter(2), 1);
+  ASSERT_EQ(gate.Counter(3), 1);
+  ASSERT_EQ(gate.Counter(7), 1);
+  ASSERT_EQ(gate.Counter(9), 1);
+  ASSERT_EQ(gate.Counter(10), 1);
+}
+
+TEST_F(DBTest, AsyncOpenAdmissionAttributesColdLoadAndPinnedHit) {
+  Options options = CurrentOptions();
+  options.disable_auto_compactions = true;
+  options.max_open_files = 10;
+  DestroyAndReopen(options);
+  ASSERT_OK(Put("key", "value"));
+  ASSERT_OK(Flush());
+  Close();
+  options.skip_stats_update_on_db_open = true;
+  // Suppress the normal small initial reader set, keeping the Version's
+  // copied reader descriptors cold too. Do not unpin live Version readers.
+  auto* sync = SyncPoint::GetInstance();
+  sync->SetCallBack("VersionEditHandler::LoadTables:skip_load_table_files",
+                    [&](void* flag) { *static_cast<bool*>(flag) = true; });
+  sync->EnableProcessing();
+  Reopen(options);
+  sync->DisableProcessing();
+  sync->ClearAllCallBacks();
+  auto* cfd =
+      static_cast_with_check<ColumnFamilyHandleImpl>(db_->DefaultColumnFamily())
+          ->cfd();
+  std::vector<std::pair<FileMetaData*, int>> files;
+  for (auto* file : GetLevelFileMetadatas(0)) files.emplace_back(file, 0);
+  ASSERT_EQ(files.size(), 1);
+  ASSERT_EQ(files[0].first->fd.pinned_reader.Get(), nullptr);
+  AsyncFileOpenAdmission gate(1, 1);
+  std::atomic<bool> stop{false};
+  auto load = [&] {
+    return LoadTableHandlersHelper(
+        files, cfd->table_cache(), FileOptions(options),
+        cfd->internal_comparator(), cfd->internal_stats(), 1, false,
+        cfd->GetLatestMutableCFOptions(), 0, ReadOptions(), &stop, &gate);
+  };
+  ASSERT_OK(load());
+  ASSERT_EQ(gate.Counter(9), 1);
+  ASSERT_EQ(gate.Counter(10), 0);
+  const uint64_t cold_bytes = gate.Counter(12);
+#ifndef NIOSTATS_CONTEXT
+  ASSERT_GT(cold_bytes, 0);
+#endif
+  // The second call uses the pinned reader: another permit/call does not
+  // imply another table open or another byte read from the file system.
+  ASSERT_OK(load());
+  ASSERT_EQ(gate.Counter(9), 2);
+  ASSERT_EQ(gate.Counter(12), cold_bytes);
+  ASSERT_EQ(gate.Counter(0), 0);
+  ASSERT_EQ(gate.Counter(7), 2);
+  ASSERT_EQ(Get("key"), "value");
+}
+
+TEST(AsyncOpenAdmissionTest, CAbiRejectsInvalidLimits) {
+  for (const auto& limits : std::vector<std::pair<uint32_t, uint32_t>>{
+           {0, 1}, {1025, 1}, {1, 0}, {1, 60001}}) {
+    ASSERT_EQ(rocksdb_async_open_admission_enable(limits.first, limits.second),
+              -1);
+  }
+  ASSERT_EQ(rocksdb_async_open_admission_abi_version(), 1);
+  ASSERT_EQ(rocksdb_async_open_admission_counter(UINT32_MAX), 0);
+}
+
+TEST(AsyncOpenAdmissionTest, RegisteredWaitersKeepFifoAcrossOwners) {
+  AsyncFileOpenAdmission gate(1, 1);
+  std::atomic<bool> stop{false};
+  ASSERT_TRUE(gate.Acquire(&stop));
+  std::promise<void> first_registered, second_registered;
+  std::atomic<int> registered{0}, order{0};
+  auto* sync = SyncPoint::GetInstance();
+  sync->SetCallBack("AsyncFileOpenAdmission::Enqueued", [&](void*) {
+    if (registered.fetch_add(1) == 0)
+      first_registered.set_value();
+    else
+      second_registered.set_value();
+  });
+  sync->EnableProcessing();
+  auto open = [&] {
+    if (!gate.Acquire(&stop)) return -1;
+    const int position = order.fetch_add(1);
+    gate.Release();
+    return position;
+  };
+  auto first = std::async(std::launch::async, open);
+  first_registered.get_future().wait();
+  auto second = std::async(std::launch::async, open);
+  second_registered.get_future().wait();
+  sync->DisableProcessing();
+  sync->ClearAllCallBacks();
+  gate.Release();
+  // This previous owner must register behind both older owners, even if it
+  // races their wakeup and would otherwise reacquire the available permit.
+  const int previous_owner_position = open();
+  ASSERT_EQ(first.get(), 0);
+  ASSERT_EQ(second.get(), 1);
+  ASSERT_EQ(previous_owner_position, 2);
+  ASSERT_EQ(gate.Counter(0), 0);
+  ASSERT_EQ(gate.Counter(1), 0);
+  ASSERT_EQ(gate.Counter(8), 1);
+}
+
+TEST(AsyncOpenAdmissionTest, CancellingOneOwnerLeavesOtherOwnerLive) {
+  AsyncFileOpenAdmission gate(1, 1);
+  for (bool cancel_first : {true, false}) {
+    SCOPED_TRACE(cancel_first);
+    std::atomic<bool> owner_stop{false}, cancelled_stop{false}, live_stop{false};
+    const uint64_t cancelled_before = gate.Counter(3);
+    const uint64_t released_before = gate.Counter(7);
+    ASSERT_TRUE(gate.Acquire(&owner_stop));
+    std::promise<void> first_registered, second_registered;
+    std::atomic<int> registered{0};
+    auto* sync = SyncPoint::GetInstance();
+    sync->SetCallBack("AsyncFileOpenAdmission::Enqueued", [&](void*) {
+      if (registered.fetch_add(1) == 0) first_registered.set_value();
+      else second_registered.set_value();
+    });
+    sync->EnableProcessing();
+    auto cancelled_open = [&] { return gate.Acquire(&cancelled_stop); };
+    auto live_open = [&] {
+      bool admitted = gate.Acquire(&live_stop);
+      if (admitted) gate.Release();
+      return admitted;
+    };
+    auto first = cancel_first
+        ? std::async(std::launch::async, cancelled_open)
+        : std::async(std::launch::async, live_open);
+    first_registered.get_future().wait();
+    auto second = cancel_first
+        ? std::async(std::launch::async, live_open)
+        : std::async(std::launch::async, cancelled_open);
+    second_registered.get_future().wait();
+    auto& cancelled = cancel_first ? first : second;
+    auto& live = cancel_first ? second : first;
+    cancelled_stop.store(true, std::memory_order_release);
+    gate.NotifyWaiters();
+    const auto cancelled_ready = cancelled.wait_for(std::chrono::seconds(2));
+    // Cleanup precedes assertions, including a failed cancellation invariant.
+    gate.Release();
+    const bool cancelled_result = cancelled.get();
+    if (cancelled_result) gate.Release();
+    const bool live_result = live.get();
+    sync->DisableProcessing();
+    sync->ClearAllCallBacks();
+    ASSERT_EQ(cancelled_ready, std::future_status::ready);
+    ASSERT_FALSE(cancelled_result);
+    ASSERT_TRUE(live_result);
+    ASSERT_EQ(gate.Counter(0), 0);
+    ASSERT_EQ(gate.Counter(1), 0);
+    ASSERT_EQ(gate.Counter(3), cancelled_before + 1);
+    ASSERT_EQ(gate.Counter(7), released_before + 2);
+  }
+}
+
+TEST(AsyncOpenAdmissionTest, AlternatingFeedbackCannotPostponeProgress) {
+  AsyncFileOpenAdmission gate(1, 100);
+  std::atomic<bool> stop{false};
+  ASSERT_TRUE(gate.Acquire(&stop));
+  std::promise<void> registered;
+  auto* sync = SyncPoint::GetInstance();
+  sync->SetCallBack("AsyncFileOpenAdmission::Enqueued",
+                    [&](void*) { registered.set_value(); });
+  sync->EnableProcessing();
+  auto admitted = std::async(std::launch::async, [&] {
+    bool result = gate.Acquire(&stop);
+    if (result) gate.Release();
+    return result;
+  });
+  registered.get_future().wait();
+  // The held permit prevents admission during every healthy slice. The
+  // registered waiter should retain a deadline tied to this actual admission.
+  const auto until = std::chrono::steady_clock::now() +
+                     std::chrono::milliseconds(200);
+  do {
+    gate.Feedback(false);
+    gate.Feedback(true);
+  } while (std::chrono::steady_clock::now() < until);
+  gate.Release();
+  // Resetting the deadline on each pressure transition would force a further
+  // 100ms wait even though the previous owner completed after 200ms.
+  const auto ready = admitted.wait_for(std::chrono::milliseconds(50));
+  if (ready != std::future_status::ready) {
+    stop.store(true, std::memory_order_release);
+    gate.NotifyWaiters();
+  }
+  const bool result = admitted.get();
+  sync->DisableProcessing();
+  sync->ClearAllCallBacks();
+  ASSERT_EQ(ready, std::future_status::ready);
+  ASSERT_TRUE(result);
+  ASSERT_EQ(gate.Counter(13), 1);
+  ASSERT_EQ(gate.Counter(0), 0);
+}
+
+TEST(AsyncOpenAdmissionTest, PressureMakesProgressWithRepeatedFeedback) {
+  AsyncFileOpenAdmission gate(8, 1);
+  std::atomic<bool> stop{false};
+  gate.Feedback(true);
+  ASSERT_EQ(gate.Counter(5), 4);
+  gate.Feedback(true);
+  ASSERT_EQ(gate.Counter(5), 2);
+  gate.Feedback(true);
+  ASSERT_EQ(gate.Counter(5), 1);
+  std::atomic<bool> done{false};
+  std::promise<void> feedback_started;
+  std::thread feedback([&] {
+    gate.Feedback(true);
+    feedback_started.set_value();
+    while (!done.load(std::memory_order_acquire)) gate.Feedback(true);
+  });
+  feedback_started.get_future().wait();
+  auto admitted = std::async(std::launch::async, [&] {
+    bool result = gate.Acquire(&stop);
+    if (result) gate.Release();
+    return result;
+  });
+  const auto ready = admitted.wait_for(std::chrono::seconds(2));
+  // Always stop both workers before asserting, including a failed progress
+  // invariant, so the test can report the failure rather than deadlock.
+  done.store(true, std::memory_order_release);
+  feedback.join();
+  if (ready != std::future_status::ready) {
+    stop.store(true, std::memory_order_release);
+    gate.NotifyWaiters();
+  }
+  ASSERT_EQ(ready, std::future_status::ready);
+  ASSERT_TRUE(admitted.get());
+  ASSERT_EQ(gate.Counter(2), 1);
+  ASSERT_EQ(gate.Counter(7), 1);
+  ASSERT_EQ(gate.Counter(0), 0);
+  gate.Feedback(false);
+  ASSERT_EQ(gate.Counter(5), 2);
+}
+
+TEST(AsyncOpenAdmissionTest, PermitLimitAndCancellation) {
+  AsyncFileOpenAdmission gate(1, 1);
+  std::atomic<bool> stop{false};
+  ASSERT_TRUE(gate.Acquire(&stop));
+  std::promise<void> waiting;
+  std::atomic<bool> signalled{false};
+  auto* sync = SyncPoint::GetInstance();
+  sync->SetCallBack("AsyncFileOpenAdmission::Waiting", [&](void*) {
+    if (!signalled.exchange(true)) waiting.set_value();
+  });
+  sync->EnableProcessing();
+  auto blocked =
+      std::async(std::launch::async, [&] { return gate.Acquire(&stop); });
+  const auto ready = waiting.get_future().wait_for(std::chrono::seconds(5));
+  stop.store(true, std::memory_order_release);
+  gate.NotifyWaiters();
+  const bool result = blocked.get();
+  if (result) gate.Release();
+  gate.Release();
+  sync->DisableProcessing();
+  sync->ClearAllCallBacks();
+  ASSERT_EQ(ready, std::future_status::ready);
+  ASSERT_FALSE(result);
+  ASSERT_EQ(gate.Counter(0), 0);
+  ASSERT_EQ(gate.Counter(1), 0);
+  ASSERT_EQ(gate.Counter(3), 1);
+  ASSERT_EQ(gate.Counter(8), 1);
+}
+
 enum class ReadType : uint8_t { kGet, kMultiGet, kIterator, kNumReadTypes };
 
 class OpenFilesAsyncTest
