+namespace ROCKSDB_NAMESPACE {
+// Experimental process-wide admission for asynchronous startup SST opens only.
+// Acquire is called before FindTable, without DB or table-loading locks. The
+// caller must release every admitted operation, including failures. Pressure
+// halves concurrency and spaces admission, but cannot indefinitely pause work.
+class AsyncFileOpenAdmission {
+ public:
+  AsyncFileOpenAdmission(uint32_t maximum, uint32_t progress_interval_ms)
+      : maximum_(maximum),
+        limit_(maximum),
+        interval_(progress_interval_ms),
+        next_progress_(Clock::now()) {}
+  bool Acquire(const std::atomic<bool>* stop,
+               const std::atomic<bool>* peer_error = nullptr);
+  void Release();
+  void Feedback(bool pressure);
+  void NotifyWaiters();
+  // 0 active, 1 waiters, 2 admitted, 3 cancelled, 4 wait microseconds,
+  // 5 current limit, 6 pressure, 7 completed, 8 peak active.
+  uint64_t Counter(uint32_t selector);
+
+ private:
+  using Clock = std::chrono::steady_clock;
+  const uint32_t maximum_;
+  uint32_t limit_;
+  const std::chrono::milliseconds interval_;
+  Clock::time_point next_progress_;
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  bool pressure_ = false;
+  uint64_t active_ = 0, waiters_ = 0, admitted_ = 0, cancelled_ = 0;
+  uint64_t wait_micros_ = 0, completed_ = 0, peak_active_ = 0;
+};
+std::shared_ptr<AsyncFileOpenAdmission> ExperimentalAsyncFileOpenAdmission();
+}  // namespace ROCKSDB_NAMESPACE
