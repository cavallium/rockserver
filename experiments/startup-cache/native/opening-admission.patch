new file mode 100644
index 0000000..80f4986
--- /dev/null
+++ b/db/async_file_open_admission.h
@@ -0,0 +1,75 @@
+//  Copyright (c) Meta Platforms, Inc. and affiliates.
+//  This source code is licensed under both the GPLv2 (found in the
+//  COPYING file in the root directory) and Apache 2.0 License
+//  (found in the LICENSE.Apache file in the root directory).
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+#include "rocksdb/rocksdb_namespace.h"
+
+namespace ROCKSDB_NAMESPACE {
+// Experimental process-wide admission for asynchronous startup SST opens only.
+// Acquire is called before FindTable, without DB or table-loading locks. The
+// caller must release every admitted operation, including failures. Pressure
+// halves concurrency and spaces admission, but cannot indefinitely pause work.
+class AsyncFileOpenAdmission {
+ public:
+  AsyncFileOpenAdmission(uint32_t maximum, uint32_t progress_interval_ms)
+      : maximum_(maximum),
+        limit_(maximum),
+        interval_(progress_interval_ms),
+        next_progress_(Clock::now() + interval_) {}
+  bool Acquire(const std::atomic<bool>* stop,
+               const std::atomic<bool>* peer_error = nullptr);
+  void Release(bool table_load_attempted = false,
+               uint64_t table_load_micros = 0, uint64_t logical_bytes_read = 0,
+               bool table_load_failed = false);
+  void Feedback(bool pressure);
+  void NotifyWaiters();
+  // 0 active, 1 waiters, 2 admitted, 3 cancelled, 4 wait microseconds,
+  // 5 current limit, 6 pressure, 7 released permits, 8 peak active,
+  // 9 FindTable calls, 10 failed calls, 11 FindTable microseconds,
+  // 12 logical read bytes, 13 admissions under pressure.
+  uint64_t Counter(uint32_t selector);
+
+ private:
+  using Clock = std::chrono::steady_clock;
+  // Waiters live on their Acquire stack. Queue links are protected by mutex_.
+  // FIFO admission prevents one DB's next open from overtaking older waiters
+  // from another DB. Cancellation unlinks any waiter without allocating.
+  struct Waiter {
+    explicit Waiter(AsyncFileOpenAdmission* admission_owner)
+        : owner(admission_owner) {}
+    Waiter(const Waiter&) = delete;
+    Waiter& operator=(const Waiter&) = delete;
+    ~Waiter() {
+      if (queued) owner->RemoveWaiter(this);
+    }
+    AsyncFileOpenAdmission* const owner;
+    bool queued = true;
+    Waiter* previous = nullptr;
+    Waiter* next = nullptr;
+  };
+  void RemoveWaiter(Waiter* waiter);
+  const uint32_t maximum_;
+  uint32_t limit_;
+  const std::chrono::milliseconds interval_;
+  Clock::time_point next_progress_;
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  bool pressure_ = false;
+  uint64_t active_ = 0, waiters_ = 0, admitted_ = 0, cancelled_ = 0;
+  uint64_t wait_micros_ = 0, released_ = 0, peak_active_ = 0;
+  uint64_t table_loads_ = 0, failed_loads_ = 0, table_load_micros_ = 0;
+  uint64_t logical_bytes_read_ = 0, pressured_admissions_ = 0;
+  Waiter* first_waiter_ = nullptr;
+  Waiter* last_waiter_ = nullptr;
+};
+std::shared_ptr<AsyncFileOpenAdmission> ExperimentalAsyncFileOpenAdmission();
+}  // namespace ROCKSDB_NAMESPACE
