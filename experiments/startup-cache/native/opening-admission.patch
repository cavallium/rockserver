+// Admission is outside table loading locks: a foreground Get on the same SST
+// succeeds while every background opener is waiting for its first permit.
+TEST_F(DBTest, AsyncOpenAdmissionForegroundAndShutdown) {
+  Options options = CurrentOptions();
+  options.disable_auto_compactions = true;
+  options.max_open_files = -1;
+  options.max_file_opening_threads = 3;
+  DestroyAndReopen(options);
+  ASSERT_OK(Put("key", "value"));
+  ASSERT_OK(Flush());
+  Close();
+  ASSERT_EQ(rocksdb_async_open_admission_enable(0, 1), -1);
+  const bool already_enabled = ExperimentalAsyncFileOpenAdmission() != nullptr;
+  ASSERT_EQ(rocksdb_async_open_admission_enable(3, 60000),
+            already_enabled ? -2 : 0);
+  const uint64_t admitted_before = rocksdb_async_open_admission_counter(2);
+  const uint64_t cancelled_before = rocksdb_async_open_admission_counter(3);
+  ASSERT_EQ(rocksdb_async_open_admission_enable(3, 60000), -2);
+  options.open_files_async = true;
+  options.skip_stats_update_on_db_open = true;
+  for (bool shutdown : {false, true}) {
+    rocksdb_async_open_admission_feedback(0);
+    rocksdb_async_open_admission_feedback(1);
+    std::promise<void> waiting;
+    std::atomic<bool> signalled{false};
+    auto* sync = SyncPoint::GetInstance();
+    sync->SetCallBack("AsyncFileOpenAdmission::Waiting", [&](void*) {
+      if (!signalled.exchange(true)) waiting.set_value();
+    });
+    sync->LoadDependency(
+        {{"DBImpl::BGWorkAsyncFileOpen:Done", "AsyncOpenAdmission::Done"}});
+    sync->EnableProcessing();
+    Reopen(options);
+    ASSERT_EQ(waiting.get_future().wait_for(std::chrono::seconds(5)),
+              std::future_status::ready);
+    ASSERT_EQ(Get("key"), "value");
+    ASSERT_EQ(rocksdb_async_open_admission_counter(0), 0);
+    if (!shutdown) {
+      rocksdb_async_open_admission_feedback(0);
+      TEST_SYNC_POINT("AsyncOpenAdmission::Done");
+      ASSERT_EQ(rocksdb_async_open_admission_counter(2), admitted_before + 1);
+      ASSERT_EQ(rocksdb_async_open_admission_counter(7), admitted_before + 1);
+    }
+    Close();
+    sync->DisableProcessing();
+    sync->ClearAllCallBacks();
+    sync->ClearTrace();
+    ASSERT_EQ(rocksdb_async_open_admission_counter(0), 0);
+    ASSERT_EQ(rocksdb_async_open_admission_counter(1), 0);
+  }
+  ASSERT_EQ(rocksdb_async_open_admission_counter(3), cancelled_before + 1);
+  rocksdb_async_open_admission_feedback(0);
+}
+
+TEST_F(DBTest, AsyncOpenAdmissionPeerErrorCancelsWaiter) {
+  Options options = CurrentOptions();
+  options.disable_auto_compactions = true;
+  DestroyAndReopen(options);
+  ASSERT_OK(Put("key", "value"));
+  ASSERT_OK(Flush());
+  auto* cfd =
+      static_cast_with_check<ColumnFamilyHandleImpl>(db_->DefaultColumnFamily())
+          ->cfd();
+  FileMetaData missing;
+  missing.fd = FileDescriptor(999999, 0, 123);
+  // Both workers target an absent file. Only its first owner may FindTable;
+  // its sibling must leave admission on peer failure, without another open.
+  std::vector<std::pair<FileMetaData*, int>> files = {{&missing, 0},
+                                                      {&missing, 0}};
+  AsyncFileOpenAdmission gate(1, 60000);
+  std::atomic<bool> stop{false};
+  std::promise<void> waiting;
+  std::atomic<bool> signalled{false};
+  std::atomic<uint32_t> finds{0};
+  auto* sync = SyncPoint::GetInstance();
+  sync->SetCallBack("AsyncFileOpenAdmission::Waiting", [&](void*) {
+    if (!signalled.exchange(true)) waiting.set_value();
+  });
+  sync->SetCallBack("VersionBuilder::Rep::LoadTableHandlers::BeforeFindTable",
+                    [&](void*) {
+                      if (finds.fetch_add(1) == 0) waiting.get_future().wait();
+                    });
+  sync->EnableProcessing();
+  Status result = LoadTableHandlersHelper(
+      files, cfd->table_cache(), FileOptions(options),
+      cfd->internal_comparator(), cfd->internal_stats(), 2, false,
+      cfd->GetLatestMutableCFOptions(), 0, ReadOptions(), &stop, &gate);
+  sync->DisableProcessing();
+  sync->ClearAllCallBacks();
+  ASSERT_FALSE(result.ok());
+  ASSERT_EQ(finds.load(), 1);
+  ASSERT_EQ(gate.Counter(0), 0);
+  ASSERT_EQ(gate.Counter(1), 0);
+  ASSERT_EQ(gate.Counter(2), 1);
+  ASSERT_EQ(gate.Counter(3), 1);
+  ASSERT_EQ(gate.Counter(7), 1);
+}
+
+TEST(AsyncOpenAdmissionTest, PressureMakesProgressWithRepeatedFeedback) {
+  AsyncFileOpenAdmission gate(8, 1);
+  std::atomic<bool> stop{false};
+  gate.Feedback(true);
+  ASSERT_EQ(gate.Counter(5), 4);
+  gate.Feedback(true);
+  ASSERT_EQ(gate.Counter(5), 2);
+  gate.Feedback(true);
+  ASSERT_EQ(gate.Counter(5), 1);
+  std::atomic<bool> done{false};
+  std::promise<void> feedback_started;
+  std::thread feedback([&] {
+    gate.Feedback(true);
+    feedback_started.set_value();
+    while (!done.load(std::memory_order_acquire)) gate.Feedback(true);
+  });
+  feedback_started.get_future().wait();
+  auto admitted = std::async(std::launch::async, [&] {
+    bool result = gate.Acquire(&stop);
+    if (result) gate.Release();
+    return result;
+  });
+  const auto ready = admitted.wait_for(std::chrono::seconds(2));
+  // Always stop both workers before asserting, including a failed progress
+  // invariant, so the test can report the failure rather than deadlock.
+  done.store(true, std::memory_order_release);
+  feedback.join();
+  if (ready != std::future_status::ready) {
+    stop.store(true, std::memory_order_release);
+    gate.NotifyWaiters();
+  }
+  ASSERT_EQ(ready, std::future_status::ready);
+  ASSERT_TRUE(admitted.get());
+  ASSERT_EQ(gate.Counter(2), 1);
+  ASSERT_EQ(gate.Counter(7), 1);
+  ASSERT_EQ(gate.Counter(0), 0);
+  gate.Feedback(false);
+  ASSERT_EQ(gate.Counter(5), 2);
+}
+
+TEST(AsyncOpenAdmissionTest, PermitLimitAndCancellation) {
+  AsyncFileOpenAdmission gate(1, 1);
+  std::atomic<bool> stop{false};
+  ASSERT_TRUE(gate.Acquire(&stop));
+  std::promise<void> waiting;
+  std::atomic<bool> signalled{false};
+  auto* sync = SyncPoint::GetInstance();
+  sync->SetCallBack("AsyncFileOpenAdmission::Waiting", [&](void*) {
+    if (!signalled.exchange(true)) waiting.set_value();
+  });
+  sync->EnableProcessing();
+  auto blocked =
+      std::async(std::launch::async, [&] { return gate.Acquire(&stop); });
+  const auto ready = waiting.get_future().wait_for(std::chrono::seconds(5));
+  stop.store(true, std::memory_order_release);
+  gate.NotifyWaiters();
+  const bool result = blocked.get();
+  if (result) gate.Release();
+  gate.Release();
+  sync->DisableProcessing();
+  sync->ClearAllCallBacks();
+  ASSERT_EQ(ready, std::future_status::ready);
+  ASSERT_FALSE(result);
+  ASSERT_EQ(gate.Counter(0), 0);
+  ASSERT_EQ(gate.Counter(1), 0);
+  ASSERT_EQ(gate.Counter(3), 1);
+  ASSERT_EQ(gate.Counter(8), 1);
+}
+
