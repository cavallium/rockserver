+// Versioned research-only C ABI. Version 1 uses int feedback status and the
+// counter selectors below. This function never allocates or throws.
+uint32_t rocksdb_async_open_admission_abi_version(void);
+// Research-only C ABI; disabled until enabled. Enable once before DB::Open,
+// never replace an active controller. Returns 0 on success, -1 for invalid
+// limits, -2 if already enabled, -3 on resource failure. Limits: 1..1024
+// opens, 1..60000 milliseconds. All async openers in this process share the
+// gate (and assumed storage budget). Foreground opens and synchronous DB::Open
+// bypass it. It gates whole table opens, not bytes/IOPS, and cannot promote an
+// already running background owner.
+int rocksdb_async_open_admission_enable(uint32_t maximum,
+                                        uint32_t progress_interval_ms);
+// Thread-safe sampled external feedback, e.g. foreground tail latency/storage
+// pressure. Pressure halves the limit (floor 1) and spaces opens by the
+// progress interval; a healthy sample adds one permit up to maximum. Existing
+// opens run to completion. One sample is one control step; callers choose
+// cadence. Returns 0 on success (including disabled), -3 on resource failure.
+// Feedback never postpones the next progress deadline; FIFO registered waiters
+// from different DBs share the same admission order. No C++ exceptions escape.
+int rocksdb_async_open_admission_feedback(int pressure);
+// Thread-safe counters: 0 active, 1 waiters, 2 admitted, 3 cancelled,
+// 4 cumulative wait microseconds, 5 limit, 6 pressure, 7 released permits,
+// 8 peak active permits, 9 FindTable calls, 10 failed FindTable calls,
+// 11 cumulative FindTable microseconds (including loading-mutex waits),
+// 12 opener-thread logical bytes read during FindTable, 13 pressured
+// admissions. Calls include cache hits; released permits include
+// aborted-before-load work. Logical bytes require enabled IOStatsContext and do
+// not measure physical IO. Unknown selector / disabled gate returns 0; resource
+// failure returns UINT64_MAX. Individual counters are synchronized, but
+// separate calls are not a snapshot. Gate is retained until exit; no C++
+// exceptions escape these functions.
+uint64_t rocksdb_async_open_admission_counter(uint32_t selector);
+#ifdef __cplusplus
+}
+#endif
