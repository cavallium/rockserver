{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rockserver:benchmark:rockserver-pressure-performance-comparison-v1",
  "title": "Rockserver paired pressure performance comparison v1",
  "type": "object",
  "required": [
    "schema", "finished", "baseline_sha", "candidate_sha", "configuration_sha256",
    "host_state", "host_sha256", "hardware_description", "runtime_sha256",
    "baseline_production_sha256", "candidate_production_sha256", "workers_enforced",
    "fixed_pairs", "fresh_processes", "adaptive_stopping", "passed", "classpath_sha256",
    "scheduler", "signal"
  ],
  "properties": {
    "schema": { "const": "rockserver-pressure-performance-comparison-v1" },
    "finished": { "type": "string", "format": "date-time" },
    "baseline_sha": { "$ref": "#/$defs/gitSha" },
    "candidate_sha": { "$ref": "#/$defs/gitSha" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "host_state": { "type": "string", "minLength": 1 },
    "host_sha256": { "$ref": "#/$defs/sha256" },
    "hardware_description": { "type": "string", "minLength": 1 },
    "runtime_sha256": { "$ref": "#/$defs/sha256" },
    "baseline_production_sha256": { "$ref": "#/$defs/sha256" },
    "candidate_production_sha256": { "$ref": "#/$defs/sha256" },
    "workers_enforced": { "type": "boolean" },
    "fixed_pairs": { "const": 10 },
    "fresh_processes": { "const": 40 },
    "adaptive_stopping": { "const": false },
    "passed": { "type": "boolean" },
    "classpath_sha256": {
      "type": "object",
      "required": ["baseline_scheduler", "candidate_scheduler", "baseline_signal", "candidate_signal"],
      "properties": {
        "baseline_scheduler": { "$ref": "#/$defs/sha256" },
        "candidate_scheduler": { "$ref": "#/$defs/sha256" },
        "baseline_signal": { "$ref": "#/$defs/sha256" },
        "candidate_signal": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "scheduler": { "$ref": "#/$defs/suite" },
    "signal": { "$ref": "#/$defs/suite" }
  },
  "additionalProperties": false,
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vector": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": { "type": "number", "minimum": 0 }
    },
    "metric": {
      "type": "object",
      "required": ["baseline", "candidate", "ratio_mean", "lower_95", "upper_95", "passed", "material"],
      "properties": {
        "baseline": { "$ref": "#/$defs/vector" },
        "candidate": { "$ref": "#/$defs/vector" },
        "ratio_mean": { "type": ["number", "null"] },
        "lower_95": { "type": ["number", "null"] },
        "upper_95": { "type": ["number", "null"] },
        "passed": { "type": "boolean" },
        "material": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": ["passed", "failures", "metrics"],
      "properties": {
        "passed": { "type": "boolean" },
        "failures": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/metric" } }
      },
      "additionalProperties": false
    }
  }
}
