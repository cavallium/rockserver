{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rockserver:benchmark:rockserver-finite-deadline-contention-metadata-v2",
  "title": "Parsed finite-deadline contention metadata v2",
  "type": "object",
  "required": [
    "schema", "configuration-sha256", "metric-set-sha256", "baseline-sha", "candidate-sha",
    "baseline-worktree", "candidate-worktree", "baseline-classes", "candidate-classes",
    "baseline-production-sha256", "candidate-production-sha256", "hardware-description", "enforce",
    "fixed-pairs", "adaptive-stopping", "family-wise-alpha", "throughput-minimum-ratio",
    "cost-maximum-ratio", "multiplicity", "scheduler-operations", "scheduler-warmup-operations",
    "scheduler-submitters", "scheduler-read-workers", "scheduler-write-workers",
    "scheduler-analytical-limit", "scheduler-foreground-capacity", "scheduler-batch-capacity",
    "scheduler-work-tokens", "scheduler-cooperative-yields", "scheduler-cooperative-parks",
    "scheduler-expired-deadline-percent", "scheduler-cancellation-percent",
    "scheduler-failure-percent", "scheduler-cooperative-percent",
    "scheduler-alternate-storage-pressure", "scheduler-seed", "scheduler-timeout-nanos"
  ],
  "properties": {
    "schema": { "const": "rockserver-finite-deadline-contention-metadata-v2" },
    "configuration-sha256": { "$ref": "#/$defs/sha256" },
    "metric-set-sha256": { "$ref": "#/$defs/sha256" },
    "baseline-sha": { "$ref": "#/$defs/gitSha" },
    "candidate-sha": { "$ref": "#/$defs/gitSha" },
    "baseline-worktree": { "$ref": "#/$defs/path" },
    "candidate-worktree": { "$ref": "#/$defs/path" },
    "baseline-classes": { "$ref": "#/$defs/path" },
    "candidate-classes": { "$ref": "#/$defs/path" },
    "baseline-production-sha256": { "$ref": "#/$defs/sha256" },
    "candidate-production-sha256": { "$ref": "#/$defs/sha256" },
    "hardware-description": { "type": "string", "minLength": 1 },
    "enforce": { "type": "boolean" },
    "fixed-pairs": { "type": "integer", "minimum": 10 },
    "adaptive-stopping": { "const": false },
    "family-wise-alpha": { "const": 0.05 },
    "throughput-minimum-ratio": { "const": 0.99 },
    "cost-maximum-ratio": { "const": 1.02 },
    "multiplicity": { "const": "holm-bonferroni" },
    "scheduler-operations": { "type": "integer", "minimum": 1 },
    "scheduler-warmup-operations": { "type": "integer", "minimum": 1 },
    "scheduler-submitters": { "type": "integer", "minimum": 2 },
    "scheduler-read-workers": { "type": "integer", "minimum": 1 },
    "scheduler-write-workers": { "type": "integer", "minimum": 1 },
    "scheduler-analytical-limit": { "type": "integer", "minimum": 1 },
    "scheduler-foreground-capacity": { "type": "integer", "minimum": 1 },
    "scheduler-batch-capacity": { "type": "integer", "minimum": 1 },
    "scheduler-work-tokens": { "type": "integer", "minimum": 1 },
    "scheduler-cooperative-yields": { "type": "integer", "minimum": 1 },
    "scheduler-cooperative-parks": { "type": "integer", "minimum": 1 },
    "scheduler-expired-deadline-percent": { "$ref": "#/$defs/percent" },
    "scheduler-cancellation-percent": { "$ref": "#/$defs/percent" },
    "scheduler-failure-percent": { "$ref": "#/$defs/percent" },
    "scheduler-cooperative-percent": { "$ref": "#/$defs/percent" },
    "scheduler-alternate-storage-pressure": { "const": true },
    "scheduler-seed": { "type": "integer" },
    "scheduler-timeout-nanos": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1 },
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
